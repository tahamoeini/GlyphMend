{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlyphMend",
  "version": "2.0.0",
  "identifier": "team.negar.glyphmend.desktop",
  "build": {
    "beforeBuildCommand": "node ../web/build-tauri.mjs",
    "beforeBundleCommand": "node scripts/assemble-runtime.mjs",
    "frontendDist": "../web/dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "config": "$CONFIG/GlyphMend",
      "data": "$DATA/GlyphMend",
      "localData": "$LOCALDATA/GlyphMend",
      "cache": "$CACHE/GlyphMend",
      "log": "$LOG/GlyphMend"
    },
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GlyphMend",
        "width": 1280,
        "height": 850,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-src 'none'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "dmg"],
    "category": "Productivity",
    "shortDescription": "Local-first PDF extraction and document reconstruction",
    "license": "AGPL-3.0-or-later AND (Apache-2.0 OR MIT)",
    "resources": { "resources/runtime/": "runtime" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libc6",
          "libgcc-s1",
          "libstdc++6"
        ]
      }
    },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
